# ---------------------------------------------------------------------------
# STU LMS — contoh konfigurasi LOKAL. Jangan pernah mengisi rahasia produksi
# di berkas ini; produksi memakai secret manager (docs/11-devops-dan-deployment.md).
# ---------------------------------------------------------------------------
APP_NAME="STU LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DISPLAY_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Argon2id (keamanan/02 SEC-AUTH-01)
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=3
ARGON_THREADS=1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runtime aplikasi memakai peran DB "stu_app" (tanpa BYPASSRLS, bukan pemilik tabel).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stu_lms
DB_USERNAME=stu_app
DB_PASSWORD=stu_app_local_only
DB_SSLMODE=prefer
# Migrasi memakai peran pemilik skema "stu_migrator": php artisan migrate --database=pgsql_migrator
DB_MIGRATOR_USERNAME=stu_migrator
DB_MIGRATOR_PASSWORD=stu_migrator_local_only

# Sesi server-side di Redis, cookie __Host- (keamanan/02 SEC-AUTH-15..18).
# Catatan: cookie Secure diterima browser di http://localhost; untuk host lain gunakan HTTPS.
SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_COOKIE=__Host-stu_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=stu_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@stu-lms.test"
MAIL_FROM_NAME="${APP_NAME}"

# Pepper untuk hash token/OTP (keamanan/06). Isi dengan: php -r "echo base64_encode(random_bytes(32));"
SECURITY_PEPPER=

# Super Admin awal dibuat via: php artisan stu:bootstrap-admin --email=...
VITE_APP_NAME="${APP_NAME}"
